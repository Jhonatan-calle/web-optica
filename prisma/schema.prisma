generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- ENUMS ----------
enum Rol {
  CLIENT
  ADMIN
}

enum EstadoOrden {
  PENDIENTE
  PAGADO
  EN_PREPARACION
  DESPACHADO
  LISTO_PARA_RETIRAR
  ENTREGADO
  CANCELADO
}

enum MetodoEnvio {
  CORREO_ARGENTINO
  ANDREANI
  OCA
  SHIPNOW
  ENVIO_PROPIO
  RETIRO_LOCAL
}

enum MetodoPago {
  MERCADO_PAGO
  PAGO_EN_LOCAL
}

// ---------- USUARIOS ----------
model Usuario {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String?
  nombre      String?
  telefono    String?
  rol         Rol          @default(CLIENT)
  direcciones Direccion[]
  ordenes     Orden[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Direccion {
  id          String   @id @default(cuid())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  calle       String
  numero      String?
  departamento String?
  ciudad      String
  provincia   String
  codigoPostal String
}

// ---------- CATÁLOGO ----------
// Jerarquía de producto: Tipo (1) -> Linea (N) -> Producto (N).
// El "Tipo" es el nivel superior (ej. "Anteojo de Sol", "Clip-on", "Armazón");
// un Tipo puede tener varias Líneas/Colecciones, pero cada Línea pertenece a un único Tipo.
model Tipo {
  id     String  @id @default(cuid())
  nombre String  @unique
  lineas Linea[]
}

model Linea {
  id          String    @id @default(cuid())
  tipo        Tipo      @relation(fields: [tipoId], references: [id])
  tipoId      String
  nombre      String
  descripcion String?
  // Imagen/portada de la línea (colección). Ej. "/lineas/linea-sun.jpg".
  imagenUrl   String?
  orden       Int?
  productos   Producto[]
}

model Producto {
  id          String    @id @default(cuid())
  linea       Linea     @relation(fields: [lineaId], references: [id], onDelete: Cascade)
  lineaId     String
  nombre      String
  slug        String    @unique
  descripcion String?
  // Nota (Fase 2): los productos con destacado = true alimentan el bloque
  // "Productos Destacados" de la Home.
  destacado   Boolean   @default(false)
  activo      Boolean   @default(true)
  variantes   Variante[]
  // Nota (Fase 2): la etiqueta "NUEVO" de las cards se CALCULA a partir de este
  // campo (producto nuevo si createdAt es reciente). Umbral de días (N) por definir.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Variante {
  id                 String     @id @default(cuid())
  producto           Producto   @relation(fields: [productoId], references: [id], onDelete: Cascade)
  productoId         String
  sku                String?    @unique
  color              String?
  material           String?
  precio             Decimal    @db.Decimal(10, 2)
  // Nota (Fase 2): la etiqueta de descuento ("10% OFF") de las cards está
  // calculada a partir de la diferencia entre precio y precioTransferencia.
  precioTransferencia Decimal?  @db.Decimal(10, 2)
  stock              Int        @default(0)
  imagenes           Imagen[]
  items              ItemOrden[]
}

model Imagen {
  id         String   @id @default(cuid())
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  varianteId String
  url        String
  alt        String?
  orden      Int?
}

// ---------- ÓRDENES ----------
model Orden {
  id         String       @id @default(cuid())
  numero     Int          @unique @default(autoincrement())
  usuario    Usuario?     @relation(fields: [usuarioId], references: [id])
  usuarioId  String?
  emailContacto  String
  estado     EstadoOrden  @default(PENDIENTE)
  metodoPago MetodoPago
  metodoEnvio MetodoEnvio

  dirCalle      String?
  dirNumero     String?
  dirDepartamento String?
  dirCiudad     String?
  dirProvincia  String?
  dirCodigoPostal String?

  costoEnvio Decimal? @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  total      Decimal  @db.Decimal(10, 2)
  mpPaymentId String?

  items      ItemOrden[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model ItemOrden {
  id             String    @id @default(cuid())
  orden          Orden     @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  ordenId        String
  variante       Variante? @relation(fields: [varianteId], references: [id])
  varianteId     String?

  nombreSnapshot String    @db.VarChar(255)
  colorSnapshot  String?
  precioUnitario Decimal   @db.Decimal(10, 2)
  cantidad       Int
  subtotal       Decimal   @db.Decimal(10, 2)
}

// ---------- CONFIGURACIÓN ----------
// Configuración global de la tienda (clave-valor), editable desde el panel admin.
// Ej. cuotas: "cuotas_cantidad" -> "3", "cuotas_con_interes" -> "false".
model Configuracion {
  id    String @id @default(cuid())
  clave String @unique
  valor String
}
