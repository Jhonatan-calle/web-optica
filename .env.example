# ============================================================
# Variables de entorno — copia este archivo a `.env.local`
#   cp .env.example .env.local
# Luego completá cada valor con tus credenciales reales.
# NO comitees `.env.local` (está en .gitignore).
# ============================================================

# --- Base de datos (Supabase / PostgreSQL) ---

# Conexión POOLED (transaccional) — la usa la app en runtime (Prisma adapter).
# Puerta: puerto 6543 del pooler de Supabase.
DATABASE_URL="postgresql://<usuario>:<password>@<host>.supabase.com:6543/postgres"

# Conexión DIRECTA — la usan SOLO las migraciones de Prisma (CLI).
# Puerta: puerto 5432 (evita que las migraciones cuelguen con el pooler).
DIRECT_URL="postgresql://<usuario>:<password>@<host>.supabase.com:5432/postgres"

# --- Supabase (opcional por ahora; se usa para auth/almacenamiento) ---

NEXT_PUBLIC_SUPABASE_URL="https://<proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"
